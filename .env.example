# Replace values in Railway Variables. Never commit real secrets.
BOT_TOKEN=
DATABASE_URL=
WEBHOOK_SECRET=
OPENAI_API_KEY=
# Payment mode: keep off until audited and explicitly enabled.
PAYMENTS_MODE=off
# Optional, controlled by operator:
IMAGE_EDIT_MODEL=
SKINCAR_DAILY_LIMIT_EXEMPT_TELEGRAM_IDS=
TESTER_TELEGRAM_ID=
WHEEL_GENERATION_MODE=
WHEEL_PILOT_TESTER_IDS=
WHEEL_APPROVED_SKUS=

PAYMENT_TESTER_IDS=

# SK-089: explicit public_beta opens generation with unverified film references to all authenticated users.
# Default is OFF when unset. Do not use live until rights and SKUs are independently approved.
# Available modes: off, pilot, public_beta, live.
FILM_GENERATION_MODE=public_beta
# Optional restrictive allowlist, comma-separated full SKUs like vega-color-ppf/ppf-101
FILM_APPROVED_SKUS=
# Used only if FILM_GENERATION_MODE=pilot
FILM_PILOT_TESTER_IDS=

# SK-108: optional, USD per 1 million tokens. No price is assumed when unset.
# Configure ONLY verified tariffs for your exact IMAGE_EDIT_MODEL, or leave empty.
# Example format (NUMBERS BELOW ARE PLACEHOLDERS, NOT LIVE PRICES):
# SKINCAR_IMAGE_RATES_JSON={"YOUR_EXACT_MODEL":{"text":1,"image":2,"output":3,"version":"verified-YYYY-MM-DD"}}
SKINCAR_IMAGE_RATES_JSON=
